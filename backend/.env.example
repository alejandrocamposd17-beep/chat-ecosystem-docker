# Solo para desarrollo local fuera de Docker.
# En Docker, la configuracion llega desde el .env de la raiz via docker-compose.
APP_NAME="Chat API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chat_db
DB_USERNAME=chat_user
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FRONTEND_URL=http://localhost:3000
CHAT_SELF_USER_ID=1
