# ===========================================================
# Copia este archivo como .env y cambia los valores sensibles
#   cp .env.example .env
# ===========================================================

# ---------- MySQL ----------
# Password del usuario root (solo para administracion)
MYSQL_ROOT_PASSWORD=cambia_esto_root
# Base de datos que se crea al iniciar el contenedor por primera vez
MYSQL_DATABASE=chat_db
# Usuario de la aplicacion (Laravel se conecta con este, nunca con root)
MYSQL_USER=chat_user
MYSQL_PASSWORD=cambia_esto_user

# ---------- Laravel API ----------
APP_NAME="Chat API"
# Genera la llave con:
#   docker compose run --rm --no-deps --entrypoint php api artisan key:generate --show
APP_KEY=
# URL publica de la API (como la ve el navegador)
API_PUBLIC_URL=http://localhost:8000
# Puerto del host donde se publica la API
API_PORT=8000
# Origen(es) permitido(s) para CORS, separados por coma
FRONTEND_URL=http://localhost:3000
# Ejecutar migraciones al iniciar el contenedor (true/false)
RUN_MIGRATIONS=true
# Cargar datos de ejemplo si la base esta vacia (true/false)
SEED_DATABASE=true
# ID del usuario que representa "yo" en el chat
CHAT_SELF_USER_ID=1

# ---------- Next.js ----------
# URL de la API para el navegador. Se incrusta en el build:
# si la cambias, reconstruye con: docker compose build web
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Puerto del host donde se publica el frontend
WEB_PORT=3000
